{
	"name": "pi-glyphs",
	"version": "0.1.0",
	"description": "Nerd Font, Unicode, emoji and pure-ASCII icon presets for Pi's tool rows and chat surface",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"nerd-fonts",
		"icons",
		"glyphs",
		"tui"
	],
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"src",
		"test",
		"scripts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"scripts": {
		"test": "node test/run.mjs && node test/integration.mjs",
		"test:unit": "node test/run.mjs",
		"test:integration": "node test/integration.mjs",
		"preview": "node scripts/preview.mjs",
		"typecheck": "tsc -p tsconfig.json"
	}
}
